# App 基础信息与本地开发入口
APP_NAME=EchoWhale API
# APP_ENV 采用非生产白名单制（大小写不敏感）：development / dev / test / testing /
# local 之外的任何值——包括 production / prod / staging / live / 空串 / 拼写错误——
# 一律按生产标准执行启动校验（fail-closed）：缺任一必填项直接启动失败。
# 生产必填清单：
#   AUTH_JWT_SECRET（非默认值且 >= 32 字符）、AUTH_COOKIE_SECURE=true、
#   ALLOWED_ORIGINS、FRONTEND_PUBLIC_BASE_URL、DATABASE_URL、REDIS_URL、
#   MODEL_RUNTIME_MODE=live、R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY、
#   AUTH_SMTP_HOST / AUTH_SMTP_USERNAME / AUTH_SMTP_PASSWORD / AUTH_SMTP_FROM_EMAIL、
#   DEEPGRAM_API_KEY / DEEPGRAM_AGENT_BASE_URL / DEEPGRAM_AGENT_THINK_MODEL。
APP_ENV=development
API_PREFIX=/api/v1

# 早期 demo / 本地兼容占位
DEFAULT_USER_ID=demo-user
DEFAULT_USER_NAME=Echo Learner

# 前端跨域与主数据库连接
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/echowhale
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis 与邮箱验证码/认证邮件相关配置
# REDIS_URL 在生产必填：缺失时验证码与限流会静默降级为进程内实现，多 worker 必坏。
REDIS_URL=redis://localhost:6379/0
AUTH_MAIL_QUEUE_NAME=auth-mail
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_SEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_SEND_DAILY_LIMIT=5
AUTH_EMAIL_VERIFY_MAX_ATTEMPTS=5
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=EchoWhale
AUTH_SMTP_USE_SSL=true
AUTH_SMTP_USE_STARTTLS=false

# Cloudflare R2 与媒体上传配置
R2_BUCKET=echowhale-dev-media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=900
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
# 全局请求体大小门（BodySizeLimitMiddleware）：12MB = 10MB 媒体上传上限
# + multipart 编码余量；新增更大 body 的端点时需同步上调该值。
MAX_REQUEST_BODY_BYTES=12582912
# 媒体上传限流：owner 键（每次上传消耗）+ 匿名访客 IP 兜底键；
# IP 键只用 TCP 对端地址（见下方 sessions IP 限额的说明），窗口复用 3600 秒语义。
MEDIA_UPLOAD_LIMIT=20
MEDIA_UPLOAD_IP_LIMIT=100

# 模型运行模式与视觉/文本模型提供方配置
# MODEL_RUNTIME_MODE=mock 时全部走本地假数据，开箱即用；
# 切到 live 前必须为每个启用的 provider 补齐 BASE_URL / API_KEY / MODEL，
# 否则应用启动时会因校验失败直接退出。生产模式强制 live，mock 直接拒绝启动。
MODEL_RUNTIME_MODE=mock
VISION_PRIMARY_PROVIDER=openai_compatible
VISION_PRIMARY_BASE_URL=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_MODEL=Qwen/Qwen2-VL-72B-Instruct
VISION_PRIMARY_TIMEOUT_SECONDS=60
VISION_FALLBACK_PROVIDER=mock
VISION_FALLBACK_BASE_URL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=
VISION_FALLBACK_TIMEOUT_SECONDS=60
TEXT_PRIMARY_PROVIDER=openai_compatible
TEXT_PRIMARY_BASE_URL=
TEXT_PRIMARY_API_KEY=
TEXT_PRIMARY_MODEL=
TEXT_PRIMARY_TIMEOUT_SECONDS=30
TEXT_FALLBACK_PROVIDER=mock
TEXT_FALLBACK_BASE_URL=
TEXT_FALLBACK_API_KEY=
TEXT_FALLBACK_MODEL=
TEXT_FALLBACK_TIMEOUT_SECONDS=30

# LLM 韧性与用量护栏
LLM_REQUEST_DEADLINE_SECONDS=45
LLM_MAX_RETRIES_PER_PROVIDER=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_SESSION_START_LIMIT=10
LLM_SESSION_START_WINDOW_SECONDS=3600
LLM_REPLY_LIMIT=30
LLM_REPLY_WINDOW_SECONDS=3600

# 单次调用输出硬顶（Finding 10a）：max_tokens 是输出上限而非精确计量
# （不引入 tiktoken），按引擎用途给不同预算，避免单次调用成本上不封顶。
# 每次 LLM 调用的 token 用量另落 llm_usage 账本表（迁移 0012），供按模型/按天归因。
LLM_COACH_MAX_TOKENS=300
LLM_FEEDBACK_MAX_TOKENS=400
LLM_SCENE_MAX_TOKENS=500

# LLM 复盘文案（审计 Finding 20）：复盘输出是短中文文案，预算给小；
# 复盘是增强分支——调用失败或超过 LLM_REVIEW_WAIT_SECONDS 未返回时，
# 取消任务并降级为模板复盘，回复轮照常成功。
LLM_REVIEW_MAX_TOKENS=300
LLM_REVIEW_WAIT_SECONDS=5

# 教练输出防滥用硬顶（Finding 11）：超过该字符数的模型输出直接截断并记
# coach_reply_truncated warning；正常回复远低于该值，属于防失控兜底。
LLM_COACH_OUTPUT_MAX_CHARS=2000

# 匿名访客 IP 维度兜底限额（默认 visitor 限额 ×5）
# IP 键只取 TCP 对端地址（request.client.host），不读 X-Forwarded-For：
# XFF 可被客户端伪造，用它等于把 IP 键也交给攻击者；
# 共享出口 IP（NAT/公司网络）的误伤由放大系数吸收。
LLM_SESSION_START_IP_LIMIT=50
LLM_REPLY_IP_LIMIT=150

# 部署要求（IP 限额的正确性前提）：反代（nginx/caddy 等）后面必须让 uvicorn 以
#   --proxy-headers --forwarded-allow-ips=<代理IP>
# 启动，request.client.host 才会被替换为真实客户端 IP。应用代码不解析
# X-Forwarded-For（可伪造）；未按上述方式部署时，所有客户端会共享代理 IP 的
# 限额桶，表现为全站被单个代理 IP 的配额约束。

# 语音 bootstrap 限流：owner 键（每次调用消耗一次 Deepgram token grant）+
# 匿名访客 IP 兜底键；窗口固定 3600 秒。
VOICE_BOOTSTRAP_LIMIT=5
VOICE_BOOTSTRAP_IP_LIMIT=25

# Deepgram think 代理按令牌里的 sid 限流：令牌 TTL 内可复用，靠会话维度配额约束；
# 另有 sid 存在性校验（伪造/已删除会话的令牌一律 401）。
THINK_PROXY_LIMIT=120
THINK_PROXY_WINDOW_SECONDS=300

# 进程内限流字典的键容量上限（LRU 淘汰最久未用键），防止 key 无界增长；
# 仅作用于内存实现，Redis 变体的键自带 TTL，不受此值影响。
RATE_LIMITER_MAX_KEYS=10000

# 场景分析缓存与异步任务（第三批）
# SCENE_ANALYSIS_CACHE_ENABLED=true 时按 media_id 复用分析结果，重复开课不再调视觉模型；
# SCENE_ANALYSIS_ASYNC_ENABLED=true 时缓存未命中转 RQ 异步分析（start 返回 202 + 轮询），
# 生产开启前确认 worker 已消费 scene-analysis 队列；Redis 缺席自动降级为内联分析。
SCENE_ANALYSIS_CACHE_ENABLED=true
SCENE_ANALYSIS_ASYNC_ENABLED=false
SCENE_ANALYSIS_PROMPT_VERSION=v1
SCENE_ANALYSIS_QUEUE_NAME=scene-analysis

# Deepgram Voice Agent 实时语音练习配置
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_AGENT_BASE_URL=wss://api.deepgram.com/v1/agent/converse
DEEPGRAM_AGENT_TOKEN_TTL_SECONDS=600
DEEPGRAM_AGENT_LANGUAGE=en
DEEPGRAM_AGENT_LISTEN_MODEL=flux-general-en
DEEPGRAM_AGENT_LISTEN_VERSION=v2
DEEPGRAM_AGENT_LISTEN_EOT_THRESHOLD=0.7
DEEPGRAM_AGENT_LISTEN_EAGER_EOT_THRESHOLD=0.4
DEEPGRAM_AGENT_LISTEN_EOT_TIMEOUT_MS=6000
DEEPGRAM_AGENT_LISTEN_SMART_FORMAT=false
DEEPGRAM_AGENT_SPEAK_MODEL=aura-2-cordelia-en
DEEPGRAM_AGENT_OUTPUT_SAMPLE_RATE=24000
DEEPGRAM_AGENT_THINK_MODEL=gpt-4o-mini

# 学员档案（迁移 0013 user_learning_profiles）写侧封顶：
# SCENE_CAP 限制场景计数最多保留最近 N 个场景（场景名由视觉模型自由产出，
# 不封顶就是无界增长，超出后从头淘汰最旧）；CEFR_WINDOW 是滚动估计的最近
# 观测窗口（对最近 N 次 CEFR 观测取 median_low 写回估计值）。
LEARNER_PROFILE_SCENE_CAP=12
LEARNER_PROFILE_CEFR_WINDOW=10
