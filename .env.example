APP_NAME=EchoWhale API
APP_ENV=development
API_PREFIX=/api/v1
DEFAULT_USER_ID=demo-user
DEFAULT_USER_NAME=Echo Learner
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/echowhale
R2_BUCKET=echowhale-dev-media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=900
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
LLM_PROVIDER=mock
MODEL_RUNTIME_MODE=live
VISION_PRIMARY_PROVIDER=openai_compatible
VISION_PRIMARY_BASE_URL=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_MODEL=Qwen/Qwen2-VL-72B-Instruct
VISION_PRIMARY_TIMEOUT_SECONDS=60
VISION_FALLBACK_PROVIDER=openai_compatible
VISION_FALLBACK_BASE_URL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=Qwen/Qwen2-VL-72B-Instruct
VISION_FALLBACK_TIMEOUT_SECONDS=60
TEXT_PRIMARY_PROVIDER=openai_compatible
TEXT_PRIMARY_BASE_URL=
TEXT_PRIMARY_API_KEY=
TEXT_PRIMARY_MODEL=
TEXT_PRIMARY_TIMEOUT_SECONDS=30
TEXT_FALLBACK_PROVIDER=openai_compatible
TEXT_FALLBACK_BASE_URL=
TEXT_FALLBACK_API_KEY=
TEXT_FALLBACK_MODEL=
TEXT_FALLBACK_TIMEOUT_SECONDS=30

# Deepgram Voice Agent
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_AGENT_BASE_URL=wss://api.deepgram.com/v1/agent/converse
DEEPGRAM_AGENT_TOKEN_TTL_SECONDS=600
DEEPGRAM_AGENT_LANGUAGE=en
DEEPGRAM_AGENT_LISTEN_MODEL=flux-general-en
DEEPGRAM_AGENT_LISTEN_VERSION=v2
DEEPGRAM_AGENT_LISTEN_EOT_THRESHOLD=0.7
DEEPGRAM_AGENT_LISTEN_EAGER_EOT_THRESHOLD=0.4
DEEPGRAM_AGENT_LISTEN_EOT_TIMEOUT_MS=6000
DEEPGRAM_AGENT_LISTEN_SMART_FORMAT=false
DEEPGRAM_AGENT_SPEAK_MODEL=aura-2-cordelia-en
DEEPGRAM_AGENT_OUTPUT_SAMPLE_RATE=24000
DEEPGRAM_AGENT_THINK_MODEL=gpt-4o-mini
# Legacy compatibility only. The browser-direct voice hot path no longer depends on a public think proxy.
DEEPGRAM_AGENT_THINK_PROXY_PUBLIC_BASE_URL=
DEEPGRAM_AGENT_THINK_UPSTREAM_BASE_URL=
DEEPGRAM_AGENT_THINK_UPSTREAM_API_KEY=
DEEPGRAM_AGENT_THINK_TIMEOUT_SECONDS=30
DEEPGRAM_AGENT_THINK_TOKEN_TTL_SECONDS=300
